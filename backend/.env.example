# ===========================================
# DULAN FINANCE ASSISTANT - ENVIRONMENT CONFIG
# ===========================================
# NEVER put actual secrets in Git.
# This file shows placeholder values only.

# --- Application ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT=1mb

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/dulan_dev

# --- Authentication ---
JWT_ACCESS_SECRET=replace_with_secure_random_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_secure_random_64_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
BCRYPT_SALT_ROUNDS=12

# --- Rate Limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=replace_with_secure_random_token
WHATSAPP_ACCESS_TOKEN=replace_with_meta_access_token
WHATSAPP_APP_SECRET=replace_with_meta_app_secret
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_ENABLED=false

# --- AI Provider ---
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=replace_with_gemini_api_key
AI_MODEL=gemini-2.0-flash
AI_REQUEST_TIMEOUT_MS=15000
AI_MIN_CONFIDENCE=0.75
AI_PROPOSAL_EXPIRY_MINUTES=30

# --- Speech Provider ---
SPEECH_ENABLED=false
SPEECH_PROVIDER=openai
SPEECH_API_KEY=replace_with_openai_api_key
SPEECH_MODEL=whisper-1
SPEECH_REQUEST_TIMEOUT_MS=30000
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_FILE_SIZE_MB=10
VOICE_TEMP_STORAGE_PATH=./storage/temp/voice
VOICE_DELETE_AFTER_PROCESSING=true

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_URL=

# --- File Storage ---
FILE_STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Reminder Workers ---
REMINDER_SCAN_INTERVAL_MS=300000
REMINDER_DUE_DATE_DEFAULT_DAYS=3
REMINDER_POST_DUE_DEFAULT_DAYS=3
REMINDER_MAX_REMINDS_PER_INVOICE=5
REMINDER_MANUAL_COOLDOWN_MINUTES=60

# --- Summary Workers ---
SUMMARY_DAILY_CRON=0 8 * * *
SUMMARY_WEEKLY_CRON=0 9 * * 1
SUMMARY_TIMEZONE=Asia/Colombo

# --- WhatsApp Templates ---
WHATSAPP_TEMPLATE_NAMESPACE=replace_with_namespace
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_NAME_REMINDER=invoice_payment_reminder
WHATSAPP_TEMPLATE_NAME_OVERDUE=invoice_overdue_reminder
WHATSAPP_TEMPLATE_NAME_SUMMARY=daily_summary

# --- Feature Flags (Beta Control) ---
FEATURE_VOICE_INPUT=false
FEATURE_AUTOMATED_REMINDERS=false
FEATURE_SCHEDULED_SUMMARIES=false
FEATURE_ADVANCED_REPORTS=true
FEATURE_TEAM_ACCESS=false
FEATURE_INVOICE_PDF=true
FEATURE_REPORT_CSV=true

# --- Monitoring ---
HELMET_ENABLED=true
